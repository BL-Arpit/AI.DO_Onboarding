# TLS certificate paths and the server name must be configured by your operator.
server {
    listen 443 ssl;
    server_name onboarding.example.com;
    ssl_certificate /etc/ssl/onboarding/fullchain.pem;
    ssl_certificate_key /etc/ssl/onboarding/privkey.pem;
    client_max_body_size 11m;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
