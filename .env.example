# Do not use placeholders as secrets. Run: python scripts/init_env.py --email you@example.com
APP_ENV=demo
APP_URL=http://127.0.0.1:8000
APP_SECRET=GENERATE_WITH_INIT_ENV
BIND_HOST=127.0.0.1
PORT=8000
TRUSTED_HOSTS=127.0.0.1,localhost
DATABASE_URL=
DATABASE_PATH=data/onboarding.sqlite
MONGODB_URI=
MONGODB_DATABASE=aido
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=aido_employee_directory_v1
TEST_HR_EMAIL=
TEST_HR_PASSWORD=
GGUF_MODEL_PATH=/project/model/replies.gguf
GGUF_THREADS=1
GGUF_CONTEXT_TOKENS=1024
GGUF_MAX_REPLY_TOKENS=128
GOOGLE_VISION_API_KEY=
INVITE_FROM=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
BOOTSTRAP_EMAIL=you@yourcompany.com
BOOTSTRAP_PASSWORD=GENERATE_WITH_INIT_ENV
MODEL_CONFIG=config/models.toml
# Exact supplied PAN sample only. Set tesseract for real OCR in this same server.
DOCUMENT_MODE=mock_pan
DOCUMENT_CLASSIFIER=ocr
TESSERACT_PATH=
TESSERACT_LANG=eng
MAX_UPLOAD_MB=10
MAX_DOCUMENT_JOBS=1
SESSION_SECONDS=28800
SESSION_IDLE_SECONDS=1800
ENABLE_API_DOCS=true
# Used only when the corresponding provider is selected in MODEL_CONFIG.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
QDRANT_CHAT_COLLECTION=aido_private_chat_potion64_v1
