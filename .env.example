# Do not use placeholders as secrets. Run: python scripts/init_env.py --email you@example.com
APP_ENV=demo
APP_URL=http://127.0.0.1:8000
APP_SECRET=GENERATE_WITH_INIT_ENV
BIND_HOST=127.0.0.1
PORT=8000
TRUSTED_HOSTS=127.0.0.1,localhost
DATABASE_PATH=data/onboarding.sqlite
BOOTSTRAP_EMAIL=operator@example.com
BOOTSTRAP_PASSWORD=GENERATE_WITH_INIT_ENV
MODEL_CONFIG=config/models.toml
# Exact supplied PAN sample only. Set tesseract for real OCR in this same server.
DOCUMENT_MODE=mock_pan
DOCUMENT_CLASSIFIER=ocr
TESSERACT_PATH=
TESSERACT_LANG=eng
MAX_UPLOAD_MB=10
MAX_DOCUMENT_JOBS=1
SESSION_SECONDS=28800
SESSION_IDLE_SECONDS=1800
ENABLE_API_DOCS=true
# Used only when the corresponding provider is selected in MODEL_CONFIG.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
