# Required only for Gemini classification / legacy combined API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=low
GEMINI_EXTRACTION_FALLBACK_ENABLED=false
GEMINI_FALLBACK_TIMEOUT_MS=10000

# Tesseract-first extraction API. If Tesseract is incomplete and the
# Gemini key above is configured, the document is sent to Gemini as fallback.
TESSERACT_PATH=
TESSERACT_LANG=eng
TESSERACT_OEM=3
TESSERACT_PSM=3
MAX_UPLOAD_SIZE_MB=10
MAX_PDF_PAGES=10
MAX_IMAGE_PIXELS=40000000
TESSERACT_TIMEOUT_SECONDS=30
OCR_REQUEST_TIMEOUT_SECONDS=20.0
