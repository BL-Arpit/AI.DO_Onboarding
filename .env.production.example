APP_ENV=production
APP_URL=https://onboarding.example.com
APP_SECRET=GENERATE_WITH_INIT_ENV
BIND_HOST=127.0.0.1
PORT=8000
TRUSTED_HOSTS=onboarding.example.com
DATABASE_PATH=data/onboarding.sqlite
BOOTSTRAP_EMAIL=you@example.com
BOOTSTRAP_PASSWORD=GENERATE_WITH_INIT_ENV
MODEL_CONFIG=config/models.production.toml
DOCUMENT_MODE=tesseract
DOCUMENT_CLASSIFIER=ocr
TESSERACT_PATH=
TESSERACT_LANG=eng
MAX_UPLOAD_MB=10
MAX_DOCUMENT_JOBS=1
SESSION_SECONDS=28800
SESSION_IDLE_SECONDS=1800
ENABLE_API_DOCS=false
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
