{
  "version": 2,
  "purpose": "Semantic examples and routing guidance, not fuzzy matching or training data. Loaded by the conversational provider.",
  "rules": [
    "Only exact employee identifiers may bind a target.",
    "Clarify ambiguous references.",
    "Use conversation context for selected-person pronouns.",
    "All mutations require explicit server confirmation.",
    "Never treat document minimum as identity verification.",
    "One action at a time; clarify compound requests."
